# Atlas environment variables (copy to .env for local development)
# Each service reads its own config from the shared @atlas/config package.

# --- Global ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Gateway ---
GATEWAY_PORT=3000
GATEWAY_GLOBAL_PREFIX=api

# --- Infrastructure (Docker Compose local dev) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas

REDIS_HOST=localhost
REDIS_PORT=6379

PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=atlas-dev

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=atlas-gateway
