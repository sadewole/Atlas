# Atlas environment variables (copy to .env for local development)
# Each service reads its own config from the shared @atlas/config package.

# --- Global ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Gateway ---
GATEWAY_PORT=3000
GATEWAY_GLOBAL_PREFIX=api

# --- Infrastructure (Docker Compose local dev) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas

REDIS_HOST=localhost
REDIS_PORT=6379

PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=atlas-dev

# --- Service ports (REST external) ---
LEDGER_PORT=3001
SERVICE_PORT=3002  # wallet-service
TRANSFER_PORT=3003

# --- Internal gRPC (service-to-service) ---
# Each service serves a gRPC API alongside its REST API for internal calls.
LEDGER_GRPC_PORT=50051
GRPC_PORT=50052  # wallet-service
LEDGER_GRPC_URL=localhost:50051
WALLET_GRPC_URL=localhost:50052

# --- Observability ---
# OTLP HTTP endpoint for the OpenTelemetry collector (Docker Compose).
# Services export traces here; the collector forwards them to Jaeger (:16686).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Services are ESM: run them with the OTel instrumentation loader so HTTP,
# pino, postgres and gRPC are instrumented. The Nx `serve` targets already
# include this flag (see each app's project.json "serve" target).
#   node --experimental-loader=@opentelemetry/instrumentation/hook.mjs dist/main.js
