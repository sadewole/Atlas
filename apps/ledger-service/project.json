{
  "name": "ledger-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ledger-service/src",
  "projectType": "application",
  "tags": [
    "scope:ledger",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "options": {
        "main": "apps/ledger-service/src/main.ts",
        "outputPath": "dist/apps/ledger-service",
        "tsConfig": "apps/ledger-service/tsconfig.app.json",
        "swcrc": ".swcrc",
        "generatePackageJson": true,
        "assets": ["apps/ledger-service/src/**/*.proto"]
      }
    },
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/ledger-service/package.json",
        "{workspaceRoot}/dist/apps/ledger-service/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/ledger-service/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "ledger-service:build",
        "runBuildTargetDependencies": false,
        "runtimeArgs": [
          "--experimental-loader=@opentelemetry/instrumentation/hook.mjs"
        ]
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
